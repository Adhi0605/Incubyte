# Copy to .env, replace every placeholder, and load with the README commands.
# JWT_SECRET must contain at least 32 characters; generate with secrets.token_hex.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
# Optional: absolute path to a file-backed database.
# DATABASE_PATH=/absolute/path/to/inventory.db
