# Copy to .env and set a unique random secret (at least 32 characters).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# PostgreSQL takes precedence when configured. Keep actual credentials private.
# DATABASE_URL=postgresql://user:password@host:5432/forecourt
# SQLite local or single-instance persistent disk alternative:
# DATABASE_PATH=/absolute/path/to/inventory.db
# Optional initial owner account; omit BOTH for registration-only hosting.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password
# Production React output; defaults to frontend/dist relative to this repo.
# FRONTEND_DIST=/app/frontend/dist
