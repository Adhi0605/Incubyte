{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["iad1"],
  "buildCommand": "python scripts/build_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{**/.env*,**/*.env*,**/*.db*,**/*.sqlite*,**/*.dump,**/*.sql,**/*.pem,**/*.key,**/.coverage*,**/.pytest_cache/**,.agents/**,.github/**,skills-lock.json,docs/**,backend/tests/**,frontend/src/**,scripts/browser/**,backups/**,data/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
